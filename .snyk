# Snyk (https://snyk.io) policy file, patches or ignores known vulnerabilities.
version: v1.25.1
# ignores vulnerabilities until expiry date; change duration by modifying expiry date
ignore:
  SNYK-JS-FETCH-174687:
    - '*':
        reason: >-
          SSRF protection implemented via isPrivateUrl() function that blocks
          private IPs, localhost, and internal domains
        expires: 2027-01-12T00:00:00.000Z
        created: 2026-01-12T00:00:00.000Z
  SNYK-JS-REGEXP-174686:
    - '*':
        reason: >-
          ReDoS protection implemented with pattern/text length limits and
          3-second execution timeout
        expires: 2027-01-12T00:00:00.000Z
        created: 2026-01-12T00:00:00.000Z
  SNYK-JS-DOMXSS-174688:
    - '*':
        reason: >-
          False positives: Blob URLs for downloads are safe, DOMPurify is used
          for SVG, QR API is hardcoded trusted source
        expires: 2027-01-12T00:00:00.000Z
        created: 2026-01-12T00:00:00.000Z
  SNYK-JS-ELLIPTIC-7577916:
    - '*':
        reason: >-
          Low severity, transitive dependency from vite-plugin-node-polyfills
          (build-time only). No fix available without breaking changes.
        expires: 2027-01-12T00:00:00.000Z
        created: 2026-01-12T00:00:00.000Z
  SNYK-JS-ELLIPTIC-8187303:
    - '*':
        reason: >-
          Improper Verification of Cryptographic Signature - transitive dependency
          from vite-plugin-node-polyfills (build-time only). Not used in runtime.
          No remediation available without breaking changes.
        expires: 2027-01-12T00:00:00.000Z
        created: 2026-01-12T00:00:00.000Z
  SNYK-JS-PATHTRAV-174689:
    - '*':
        reason: >-
          Development script only, not exposed in production. Input is from
          developer CLI, not untrusted users.
        expires: 2027-01-12T00:00:00.000Z
        created: 2026-01-12T00:00:00.000Z
