{
    "manifest_version": 3,
    "name": "Dulundu Tools - Developer Utilities",
    "version": "1.0.0",
    "description": "All-in-one developer tools: JSON Formatter, Base64, Regex Tester and more.",
    "action": {
        "default_popup": "src/popup/index.html"
    },
    "background": {
        "service_worker": "src/background/index.ts",
        "type": "module"
    },
    "permissions": [
        "clipboardWrite",
        "clipboardRead",
        "contextMenus"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}